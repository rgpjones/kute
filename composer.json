{
    "name": "kachuru/kute",
    "description": "A package of handy scripts",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.4|>=8.5",
        "ext-bcmath": "*",
        "ext-libxml": "*",
        "firebase/php-jwt": "^7.1",
        "guzzlehttp/guzzle": "^8.1",
        "kachuru/util": "^2.1",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.0",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^8.0",
        "symfony/process": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "^9.3",
        "phpmd/phpmd": "^3.0",
        "phpspec/phpspec": "^8.3",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.13",
        "symfony/dotenv": "^8.1"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "Kachuru\\": "src/Kachuru/",
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spec\\Kachuru\\": "spec/Kachuru/"
        }
    },
    "scripts": {
        "acceptance": [
            "vendor/bin/behat"
        ],
        "spec": [
            "vendor/bin/phpspec run"
        ],
        "sniff": [
            "vendor/bin/phpcs --standard=phpcs.xml src/"
        ],
        "fix": [
            "vendor/bin/phpcbf --standard=phpcs.xml src/"
        ],
        "compatibility": [
            "vendor/bin/phpcs -s --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility/ --runtime-set testVersion 8.4- src/",
            "vendor/bin/phpcs -s --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility/ --runtime-set testVersion 8.5- src/"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "mess": [
            "vendor/bin/phpmd analyze src/Kachuru --format text --ruleset phpmd.xml"
        ],
        "quality": [
            "@sniff",
            "@compatibility",
            "@analyse",
            "@mess"
        ],
        "test": [
            "@quality",
            "@spec"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "id": "8.1",
            "allow-contrib": false
        }
    },
    "minimum-stability": "dev"
}
